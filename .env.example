# --- Base de datos principal (contenedor `postgres`, puerto 5432) ---

POSTGRES_DB=ventas_rutas
POSTGRES_USER=ventas_app
POSTGRES_PASSWORD=cambiar_en_cada_entorno

# --- Base de datos de pruebas (contenedor `postgres-test`, puerto 5433) ---

